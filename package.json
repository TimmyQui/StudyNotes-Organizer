{
  "name": "studienotities-organizer",
  "version": "1.0.0",
  "description": "Semi-automated workflow that classifies study notes by sprint and type using an LLM, with a review step for uncertain cases.",
  "keywords": ["typescript", "express", "llm", "groq", "notes", "scrum"],
  "main": "src/index.ts",
  "type": "commonjs",
  "scripts": {
    "add-note": "ts-node src/index.ts",
    "review": "ts-node src/review.ts",
    "overview": "ts-node src/overview.ts",
    "web": "ts-node src/server.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
